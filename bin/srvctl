#!/bin/bash
# ==============================================================================
# bin/srvctl - Herramienta de gestion y administracion del servidor web Debian 13
# ==============================================================================
set -eo pipefail

REAL_BIN="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SRVCTL_ROOT="$(cd "$(dirname "$REAL_BIN")/.." && pwd)"
export SRVCTL_ROOT
export SRVCTL_CORE="${SRVCTL_ROOT}/core"

# shellcheck source=/dev/null
[ -f "${SRVCTL_ROOT}/core/logger.sh" ] && . "${SRVCTL_ROOT}/core/logger.sh"
# shellcheck source=/dev/null
[ -f "${SRVCTL_ROOT}/core/validator.sh" ] && . "${SRVCTL_ROOT}/core/validator.sh"
# shellcheck source=/dev/null
[ -f "${SRVCTL_ROOT}/core/config.sh" ] && . "${SRVCTL_ROOT}/core/config.sh"

cmd_deploy() {
    validate_root
    validate_systemd
    validate_disk_space 512000

    load_config

    if [ -t 0 ] && [ "${ASISTENTE_NONINTERACTIVE:-0}" != "1" ]; then
        echo "======================================================================"
        echo "           ASISTENTE DE INSTALACION WEB - DEBIAN 13 (SRVCTL)          "
        echo "======================================================================"
        read -rp "[?] Direccion IP del servidor [${SERVER_IP}]: " in_ip
        SERVER_IP="${in_ip:-$SERVER_IP}"
        read -rp "[?] Dominio Base [${BASE_DOMAIN}]: " in_dom
        BASE_DOMAIN="${in_dom:-$BASE_DOMAIN}"
        read -rp "[?] Usuario Administrador [${ADMIN_USER}]: " in_user
        ADMIN_USER="${in_user:-$ADMIN_USER}"
        read -rp "[?] Contrasena Maestra [${ADMIN_PASS}]: " in_pass
        ADMIN_PASS="${in_pass:-$ADMIN_PASS}"

        echo ""
        echo "Parametros confirmados:"
        echo " - Servidor IP:    ${SERVER_IP}"
        echo " - Dominio Base:   *.${BASE_DOMAIN}"
        echo " - Administrador:  ${ADMIN_USER}"
        echo "======================================================================"
        read -rp "¿Iniciar despliegue? (s/N): " confirm
        [[ "$confirm" =~ ^[sS]$ ]] || { echo "Operacion cancelada."; exit 0; }
    fi

    # Guardar configuracion
    PROD_FQDN="${PROD_SUB}.${BASE_DOMAIN}"
    STG_FQDN="${STG_SUB}.${BASE_DOMAIN}"
    DB_FQDN="${DB_SUB}.${BASE_DOMAIN}"
    save_config

    log "Iniciando despliegue de la plataforma srvctl..."

    bash "${SRVCTL_ROOT}/modules/system/power.sh" apply
    bash "${SRVCTL_ROOT}/modules/system/network.sh" disable-ipv6
    bash "${SRVCTL_ROOT}/modules/security/ssh.sh" apply
    bash "${SRVCTL_ROOT}/modules/stack/base.sh"
    bash "${SRVCTL_ROOT}/modules/security/firewall.sh" apply
    bash "${SRVCTL_ROOT}/modules/stack/php.sh"
    bash "${SRVCTL_ROOT}/modules/stack/redis.sh"
    bash "${SRVCTL_ROOT}/modules/stack/mariadb.sh"
    bash "${SRVCTL_ROOT}/modules/stack/phpmyadmin.sh"
    bash "${SRVCTL_ROOT}/modules/web/ssl.sh"
    bash "${SRVCTL_ROOT}/modules/web/dashboard.sh"
    bash "${SRVCTL_ROOT}/modules/web/apache.sh"
    bash "${SRVCTL_ROOT}/modules/share/samba.sh"
    bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" setup

    # Crear entornos iniciales prod y stg si no existen
    for p in "${PROD_SUB}" "${STG_SUB}"; do
        cmd_project_create "$p" >/dev/null 2>&1 || true
    done

    log "======================================================================"
    log "  DESPLIEGUE FINALIZADO EXITOSAMENTE"
    log "======================================================================"
    log " - Portal / Dashboard:   https://${BASE_DOMAIN} (o https://${SERVER_IP})"
    log " - Produccion:           https://${PROD_FQDN}"
    log " - Pruebas:              https://${STG_FQDN}"
    log " - phpMyAdmin:           https://${DB_FQDN}"
    log " - Samba (Proyectos):    \\\\${SERVER_IP}\\proyectos"
    log "======================================================================"
}

cmd_status() {
    load_config
    echo "======================================================================"
    echo "           ESTADO DE SALUD DEL SERVIDOR - $(date '+%Y-%m-%d %H:%M:%S')"
    echo "======================================================================"
    echo " - IP Servidor:       ${SERVER_IP}"
    echo " - Dominio Base:      *.${BASE_DOMAIN}"
    echo " - Recurso Samba:     \\\\${SERVER_IP}\\proyectos"
    echo " - Dashboard Central: https://${BASE_DOMAIN}"
    echo ""
    echo "--- Metricas del Sistema ---"
    local ram_info
    ram_info=$(free -h 2>/dev/null | awk '/Mem:/ {print $3 "/" $2}')
    echo " - Uso de RAM:        ${ram_info:-N/D}"
    local disk_info
    disk_info=$(df -h /var/www 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 " usado)"}')
    echo " - Espacio en disco:  ${disk_info:-N/D}"
    echo ""
    echo "--- Estado de Servicios ---"
    for srv in apache2 "php${PHP_VER}-fpm" mariadb redis-server smbd ufw fail2ban; do
        if systemctl is-active --quiet "$srv" 2>/dev/null; then
            printf " [OK]   Servicio %-20s: Activo\n" "$srv"
        else
            printf " [FAIL] Servicio %-19s: Inactivo\n" "$srv"
        fi
    done
}

cmd_verify() {
    load_config
    local PHP_VER
    PHP_VER="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || echo "8.4")"
    if [ -z "$PHP_VER" ]; then
        PHP_VER="8.4"
    fi

    local PASS=0
    local FAIL=0
    local RESULTS=()

    check() {
        local desc="$1"; shift
        if "$@" >/dev/null 2>&1; then
            RESULTS+=("OK|${desc}")
            PASS=$((PASS+1))
        else
            RESULTS+=("FAIL|${desc}")
            FAIL=$((FAIL+1))
        fi
    }

    local_svc_active() { systemctl is-active --quiet "$1"; }

    local_http_code() {
        local url="$1"; shift
        curl -sk -o /dev/null -w '%{http_code}' "$@" "$url"
    }

    echo "=============================================================================="
    echo "           VERIFICACION DEL SERVIDOR WEB - $(date '+%Y-%m-%d %H:%M:%S')"
    echo "=============================================================================="

    # --- Servicios -----------------------------------------------------------------
    check "Servicio apache2 activo"            local_svc_active apache2
    check "Servicio php${PHP_VER}-fpm activo"  local_svc_active "php${PHP_VER}-fpm"
    check "Servicio mariadb activo"            local_svc_active mariadb
    check "Servicio redis-server activo"       bash -c "systemctl is-active --quiet redis-server || systemctl is-active --quiet redis"
    check "Servicio smbd activo"               local_svc_active smbd
    check "Servicio fail2ban activo"           local_svc_active fail2ban
    check "Firewall UFW activo"                bash -c "ufw status | grep -q 'Status: active'"
    check "Socket PHP-FPM existe"              test -S "/run/php/php${PHP_VER}-fpm.sock"
    check "Composer instalado globalmente"     bash -c "command -v composer >/dev/null 2>&1"

    # --- Usuario administrador / sudo ---------------------------------------------
    local ADMIN_USER_V
    ADMIN_USER_V="$(awk -F: '$3>=1000 && $3<65534 && $7 ~ /(bash|zsh|sh)$/ {print $1; exit}' /etc/passwd)"
    check "Usuario de instalacion en sudo"      bash -c "id -nG '${ADMIN_USER_V}' 2>/dev/null | tr ' ' '\n' | grep -qx sudo"
    check "Usuario admin existe"                id "${ADMIN_USER:-webadmin}"

    # --- Puertos UFW ---------------------------------------------------------------
    for p in 22 80 443 445 3389; do
        check "UFW permite puerto ${p}/tcp" bash -c "ufw status | grep -q '${p}/tcp'"
    done

    # --- Web (HTTPS con SNI via --resolve) -----------------------------------------
    local code
    code="$(local_http_code "https://${BASE_DOMAIN}/" --resolve "${BASE_DOMAIN}:443:127.0.0.1")"
    check "Dashboard HTTPS responde 200 (${BASE_DOMAIN}) [${code}]" test "$code" = "200"

    for pair in "Produccion:${PROD_FQDN}" "Staging:${STG_FQDN}" "phpMyAdmin:${DB_FQDN}"; do
        local name="${pair%%:*}"
        local host="${pair#*:}"
        code="$(local_http_code "https://${host}/" --resolve "${host}:443:127.0.0.1")"
        check "${name} HTTPS responde 200 ($host) [${code}]" test "$code" = "200"
    done

    # --- Acceso por ruta (dual-access) ---------------------------------------------
    code="$(local_http_code "https://${BASE_DOMAIN}/prod/" --resolve "${BASE_DOMAIN}:443:127.0.0.1")"
    check "Ruta /prod/ responde 200 (${BASE_DOMAIN}/prod/) [${code}]" test "$code" = "200"

    code="$(curl -sk -o /dev/null -w '%{http_code}' --resolve "${BASE_DOMAIN}:443:127.0.0.1" "https://${BASE_DOMAIN}/prod")"
    check "Ruta /prod redirige 301 a /prod/ [${code}]" test "$code" = "301"

    code="$(local_http_code "https://${BASE_DOMAIN}/phpmyadmin/" --resolve "${BASE_DOMAIN}:443:127.0.0.1")"
    check "Ruta /phpmyadmin/ responde 200 (${BASE_DOMAIN}/phpmyadmin/) [${code}]" test "$code" = "200"

    # --- Redireccion HTTP -> HTTPS -------------------------------------------------
    for pair in "Dashboard:${BASE_DOMAIN}" "Produccion:${PROD_FQDN}" "Staging:${STG_FQDN}" "phpMyAdmin:${DB_FQDN}"; do
        local name="${pair%%:*}"
        local host="${pair#*:}"
        code="$(curl -s -o /dev/null -w '%{http_code}' -H "Host: ${host}" "http://127.0.0.1/")"
        check "${name} redirige 301 a HTTPS [${code}]" test "$code" = "301"
    done

    # --- PHP ejecuta ---------------------------------------------------------------
    check "PHP-FPM procesa PHP (Produccion)" bash -c \
      "[ \"$(local_http_code "https://${PROD_FQDN}/" --resolve "${PROD_FQDN}:443:127.0.0.1")\" = 200 ] && \
       curl -sk --resolve \"${PROD_FQDN}:443:127.0.0.1\" \"https://${PROD_FQDN}/\" | grep -qi 'php'"

    # --- phpMyAdmin: almacenamiento de configuracion -------------------------------
    local PMA_INFO
    PMA_INFO="$(php -r "\$d=''; @include '/etc/phpmyadmin/config-db.php'; echo (\$dbuser??'').'|'.(\$dbpass??'').'|'.(\$dbname??'');" 2>/dev/null)"
    local PMA_USER_V="${PMA_INFO%%|*}"
    local PMA_REST="${PMA_INFO#*|}"
    local PMA_PASS_V="${PMA_REST%%|*}"
    local PMA_DB_V="${PMA_REST#*|}"

    check "phpMyAdmin: config-db.php con usuario"  test -n "$PMA_USER_V"
    check "phpMyAdmin: config-db.php con clave"    test -n "$PMA_PASS_V"
    check "phpMyAdmin: pmadb = phpmyadmin"         test "$PMA_DB_V" = "phpmyadmin"

    local PMA_TBL_COUNT
    PMA_TBL_COUNT="$(mariadb -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='phpmyadmin' AND table_name LIKE 'pma\\_\\_%';" 2>/dev/null || echo 0)"
    check "phpMyAdmin: tablas pma__ presentes (${PMA_TBL_COUNT})" bash -c "[ '${PMA_TBL_COUNT}' -ge 19 ]"

    if [ -n "$PMA_USER_V" ]; then
        check "phpMyAdmin: controluser conecta a pmadb" \
          mariadb -u "$PMA_USER_V" -p"$PMA_PASS_V" -e "SELECT 1;" phpmyadmin
    fi

    # Login real end-to-end a phpMyAdmin
    local PMA_CJ
    local PMA_BODY
    local PMA_TOKEN
    PMA_CJ="$(mktemp)"
    PMA_BODY="$(mktemp)"
    curl -sk -c "$PMA_CJ" -o "$PMA_BODY" --resolve "${DB_FQDN}:443:127.0.0.1" "https://${DB_FQDN}/index.php" 2>/dev/null
    PMA_TOKEN="$(sed -n 's/.*name="token" value="\([^"]*\)".*/\1/p' "$PMA_BODY" | head -1)"
    curl -sk -L -b "$PMA_CJ" -c "$PMA_CJ" -o "$PMA_BODY" --resolve "${DB_FQDN}:443:127.0.0.1" \
      --data-urlencode "pma_username=${ADMIN_USER}" \
      --data-urlencode "pma_password=${ADMIN_PASS}" \
      --data-urlencode "server=1" \
      --data-urlencode "token=${PMA_TOKEN}" \
      "https://${DB_FQDN}/index.php" 2>/dev/null

    check "phpMyAdmin: login real correcto" bash -c "! grep -qiE 'pma_username|Cannot log in|Access denied for user' '${PMA_BODY}'"
    check "phpMyAdmin: sin aviso de almacenamiento (tras login)" bash -c "! grep -qi 'configuration storage is not completely configured' '${PMA_BODY}'"
    check "Twig: sin advertencias deprecadas (tras login)" bash -c "! grep -qiE 'getExpressionParser|ExpressionParser::parseExpression|Since twig/twig 3\\.21' '${PMA_BODY}'"
    rm -f "$PMA_CJ" "$PMA_BODY"

    # --- SSL -----------------------------------------------------------------------
    check "Certificado comodin emitido"            test -f /etc/ssl/localcerts/webserver.crt
    check "CA raiz existe"                         test -f /etc/ssl/localcerts/rootCA.crt
    check "rootCA.crt disponible en downloads"     test -f /var/www/_dashboard/downloads/rootCA.crt

    # --- Samba ---------------------------------------------------------------------
    check "Samba: configuracion valida"            testparm -s
    check "Samba: recurso maestro [proyectos]"      bash -c "testparm -s 2>/dev/null | grep -q '\\[proyectos\\]'"

    # --- Respaldos -----------------------------------------------------------------
    check "Backup: script ejecutable"              test -x /opt/scripts/backup-daily.sh
    check "Backup: cron instalado"                 test -f /etc/cron.d/web-daily-backup
    check "Backup: snapshot diario generado"       bash -c "test -d /var/backups/srvctl/snapshots/daily.0 || test -d /backup/snapshots/daily.0"

    # --- Resultados ----------------------------------------------------------------
    echo ""
    printf "%-6s %s\n" "ESTADO" "COMPROBACION"
    echo "------------------------------------------------------------------------------"
    for r in "${RESULTS[@]}"; do
        local st="${r%%|*}"
        local ds="${r#*|}"
        if [ "$st" = "OK" ]; then
            printf "[ OK ] %s\n" "$ds"
        else
            printf "[FAIL] %s\n" "$ds"
        fi
    done
    echo "------------------------------------------------------------------------------"
    echo "TOTAL: ${PASS} OK / ${FAIL} FALLOS"
    echo "=============================================================================="

    [ "$FAIL" -eq 0 ]
}

cmd_project_create() {
    validate_root
    load_config
    local name="$1"
    [ -n "$name" ] || die "Debes especificar el nombre del proyecto. Ej: srvctl project create tienda"

    if ! validate_subdomain "$name"; then
        die "Nombre de proyecto invalido. Usa solo letras minusculas, numeros y guiones."
    fi

    local pdir="/var/www/${name}"
    local pubdir="${pdir}/public_html"

    mkdir -p "${pubdir}"

    if [ ! -f "${pubdir}/index.php" ] && [ ! -f "${pubdir}/index.html" ]; then
        cat <<EOF > "${pubdir}/index.php"
<?php header('Content-Type: text/html; charset=UTF-8'); ?>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${name} - ${name}.${BASE_DOMAIN}</title>
<style>body{font-family:sans-serif;margin:40px;background:#0f172a;color:#f8fafc}.card{background:#1e293b;padding:25px;border-radius:8px;border-left:6px solid #38bdf8;box-shadow:0 2px 5px rgba(0,0,0,0.2)}h1{margin-top:0}.badge{background:#0284c7;color:#fff;padding:4px 8px;border-radius:4px;font-weight:bold}</style></head>
<body><div class="card"><h1>Servidor Web Nativo - <span class="badge">${name}</span></h1><p><strong>Subdominio:</strong> https://${name}.${BASE_DOMAIN}</p><p><strong>Ruta:</strong> https://${BASE_DOMAIN}/${name}/</p><p><strong>PHP:</strong> <?= phpversion(); ?></p><p><strong>DocumentRoot:</strong> <?= __DIR__; ?></p></div></body></html>
EOF
    fi

    chown -R "${ADMIN_USER}":www-data "${pdir}"
    find "${pdir}" -type d -exec chmod 2775 {} \;
    find "${pdir}" -type f -exec chmod 0664 {} \;

    git config --system --add safe.directory "${pubdir}" >/dev/null 2>&1 || true
    (
        cd "${pubdir}"
        if [ ! -d .git ]; then
            git init -b main >/dev/null 2>&1 || true
            git config user.name "Administrador Web" >/dev/null 2>&1 || true
            git config user.email "admin@${BASE_DOMAIN}" >/dev/null 2>&1 || true
            git add . >/dev/null 2>&1 || true
            git commit -m "Commit inicial: ${name}" >/dev/null 2>&1 || true
        fi
    )

    log "[Proyecto] Creado: ${name} -> https://${name}.${BASE_DOMAIN} (/var/www/${name})"

    bash "${SRVCTL_ROOT}/modules/web/dashboard.sh" >/dev/null 2>&1 || true
}

cmd_project_list() {
    load_config
    echo "======================================================================"
    echo "                         PROYECTOS ACTIVOS                            "
    echo "======================================================================"
    for d in /var/www/*; do
        if [ -d "$d" ]; then
            local bname
            bname=$(basename "$d")
            if [ "$bname" != "html" ] && [[ ! "$bname" =~ ^_ ]]; then
                printf " - %-20s -> https://%s.%s\n" "$bname" "$bname" "${BASE_DOMAIN}"
            fi
        fi
    done
}

cmd_project_db() {
    validate_root
    load_config
    local name="$1"
    local db_name_arg="${2:-}"
    [ -n "$name" ] || die "Debes especificar el nombre del proyecto. Ej: srvctl project db tienda"

    if ! validate_subdomain "$name"; then
        die "Nombre de proyecto invalido. Usa solo letras minusculas, numeros y guiones."
    fi

    local db_name
    if [ -n "$db_name_arg" ]; then
        if [[ ! "$db_name_arg" =~ ^[a-z0-9_]{1,64}$ ]]; then
            die "Nombre de base de datos invalido. Usa solo minusculas, numeros y guion bajo (max 64)."
        fi
        db_name="$db_name_arg"
    else
        db_name="${name//-/_}_db"
    fi
    local db_user="${name//-/_}_usr"
    db_user="${db_user:0:32}"
    local db_pass
    db_pass="$(openssl rand -base64 24 | tr -d '/+=' | head -c 24)"

    log "[Base de Datos] Creando base de datos ${db_name} y usuario ${db_user}..."
    mariadb -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    mariadb -e "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass}';"
    mariadb -e "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass}';"
    mariadb -e "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'localhost';"
    mariadb -e "CREATE USER IF NOT EXISTS '${db_user}'@'127.0.0.1' IDENTIFIED BY '${db_pass}';"
    mariadb -e "ALTER USER '${db_user}'@'127.0.0.1' IDENTIFIED BY '${db_pass}';"
    mariadb -e "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'127.0.0.1';"
    mariadb -e "FLUSH PRIVILEGES;"

    local pubdir="/var/www/${name}/public_html"
    if [ -d "${pubdir}" ]; then
        local env_file="${pubdir}/.env"
        local env_tmp
        env_tmp="$(mktemp)"
        if [ -f "${env_file}" ]; then
            grep -vE '^(DB_CONNECTION|DB_HOST|DB_PORT|DB_DATABASE|DB_USERNAME|DB_PASSWORD)=' "${env_file}" > "${env_tmp}" 2>/dev/null || true
        fi
        {
            echo "# Configuracion de base de datos creada por srvctl"
            echo "DB_CONNECTION=mysql"
            echo "DB_HOST=127.0.0.1"
            echo "DB_PORT=3306"
            echo "DB_DATABASE=${db_name}"
            echo "DB_USERNAME=${db_user}"
            echo "DB_PASSWORD=${db_pass}"
        } >> "${env_tmp}"
        cat "${env_tmp}" > "${env_file}"
        rm -f "${env_tmp}"
        chown "${ADMIN_USER}":www-data "${env_file}"
        chmod 660 "${env_file}"
        log "[Base de Datos] Archivo de entorno actualizado en ${env_file}"
    fi

    echo "======================================================================"
    echo "         BASE DE DATOS CONFIGURADA CON EXITO                          "
    echo "======================================================================"
    echo " - Host:        127.0.0.1 (o localhost)"
    echo " - Puerto:      3306"
    echo " - Base Datos:  ${db_name}"
    echo " - Usuario:     ${db_user}"
    echo " - Contrasena:  ${db_pass}"
    echo " - phpMyAdmin:  https://${DB_FQDN}"
    echo "======================================================================"
}

cmd_project_delete() {
    validate_root
    load_config
    local name="$1"
    local force="${2:-}"
    [ -n "$name" ] || die "Debes especificar el nombre del proyecto. Ej: srvctl project delete tienda"

    if ! validate_subdomain "$name"; then
        die "Nombre de proyecto invalido. Usa solo letras minusculas, numeros y guiones."
    fi

    if { [ "$name" = "prod" ] || [ "$name" = "stg" ] || [ "$name" = "html" ] || [[ "$name" =~ ^_ ]]; } && [ "$force" != "--force" ]; then
        die "No se permite eliminar proyectos base del sistema (${name}) sin --force."
    fi

    local pdir="/var/www/${name}"
    local env_file="${pdir}/public_html/.env"
    local env_db=""
    if [ -f "${env_file}" ]; then
        env_db="$(awk -F= '/^DB_DATABASE=/{print $2; exit}' "${env_file}" 2>/dev/null || true)"
    fi

    if [ -d "${pdir}" ]; then
        rm -rf "${pdir}"
        log "[Proyecto] Directorio web eliminado: ${pdir}"
    fi

    local db_name="${name//-/_}_db"
    local db_user="${name//-/_}_usr"
    mariadb -e "DROP DATABASE IF EXISTS \`${db_name}\`;" 2>/dev/null || true
    if [ -n "${env_db}" ] && [ "${env_db}" != "${db_name}" ]; then
        mariadb -e "DROP DATABASE IF EXISTS \`${env_db}\`;" 2>/dev/null || true
    fi
    mariadb -e "DROP USER IF EXISTS '${db_user}'@'localhost', '${db_user}'@'127.0.0.1';" 2>/dev/null || true

    log "[Proyecto] Proyecto '${name}' y base de datos eliminados correctamente."
}

cmd_reset() {
    validate_root
    log "[Reset] Restaurando servidor al estado base limpio..."
    bash "${SRVCTL_ROOT}/modules/security/firewall.sh" disable
    systemctl stop apache2 "php${PHP_VER:-8.4}-fpm" mariadb redis-server smbd fail2ban 2>/dev/null || true

    export DEBIAN_FRONTEND=noninteractive
    apt-get purge -y \
      'apache2*' 'libapache2-mod-fcgid' 'php*' 'phpmyadmin*' \
      'mariadb*' 'galera*' 'samba*' 'winbind' 'fail2ban' 'ufw' 'auditd' 'redis*' 2>/dev/null || true

    apt-get autoremove --purge -y >/dev/null 2>&1 || true
    apt-get clean >/dev/null 2>&1 || true

    rm -rf /var/www/prod /var/www/stg /var/www/_dashboard
    rm -rf /etc/apache2 /etc/php /etc/mysql /etc/samba /var/lib/mysql /etc/phpmyadmin /etc/ssl/localcerts /backup /var/backups/srvctl /opt/scripts
    rm -f /var/log/backup-daily.log /var/log/sudo.log /etc/cron.d/web-daily-backup /etc/srvctl.conf /etc/srvctl-panel.conf /etc/asistente_servidor.conf /etc/sudoers.d/srvctl-web

    mkdir -p /var/www/html
    chown -R root:root /var/www

    bash "${SRVCTL_ROOT}/modules/system/power.sh" revert
    bash "${SRVCTL_ROOT}/modules/system/network.sh" enable-ipv6
    bash "${SRVCTL_ROOT}/modules/security/ssh.sh" revert

    log "[Reset] Sistema restaurado al estado base limpio."
}

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
}

api_security() {
    validate_root
    local ufw_enabled="false" ufw_in="N/D" ufw_out="N/D" first=1 r defline
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | head -1 | grep -qi 'Status: active'; then
        ufw_enabled="true"
    fi
    defline="$(ufw status verbose 2>/dev/null | grep -i '^Default:' || true)"
    if [ -n "$defline" ]; then
        ufw_in="$(printf '%s' "$defline" | sed -n 's/.*Default: *\([a-z]*\) (incoming).*/\1/p')"
        ufw_out="$(printf '%s' "$defline" | sed -n 's/.*, *\([a-z]*\) (outgoing).*/\1/p')"
    fi

    printf '{"ufw":{"enabled":%s,"default_incoming":"%s","default_outgoing":"%s","rules":[' \
        "$ufw_enabled" "$(json_escape "$ufw_in")" "$(json_escape "$ufw_out")"
    while IFS= read -r r; do
        [ -z "$r" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '"%s"' "$(json_escape "$r")"
    done < <(ufw status 2>/dev/null | grep -E 'ALLOW|DENY|REJECT|LIMIT' || true)
    printf ']},'

    local fb_active="false" jail_list j
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
        fb_active="true"
    fi
    jail_list="$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' ' ' || true)"
    printf '"fail2ban":{"active":%s,"jails":[' "$fb_active"
    first=1
    for j in $jail_list; do
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '"%s"' "$(json_escape "$j")"
    done
    printf '],"banned":{'
    first=1
    for j in $jail_list; do
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '"%s":[' "$(json_escape "$j")"
        local ips f2=1 ip
        ips="$(fail2ban-client status "$j" 2>/dev/null | sed -n 's/.*Banned IP list:[[:space:]]*//p' || true)"
        for ip in $ips; do
            [ "$f2" -eq 1 ] || printf ','
            f2=0
            printf '"%s"' "$(json_escape "$ip")"
        done
        printf ']'
    done
    printf '}},'

    local prl mat
    prl="$(grep -rhiE '^[[:space:]]*PermitRootLogin' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | tail -1 | awk '{print $2}' || true)"
    mat="$(grep -rhiE '^[[:space:]]*MaxAuthTries' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | tail -1 | awk '{print $2}' || true)"
    printf '"ssh":{"permit_root_login":"%s","max_auth_tries":"%s"},' \
        "$(json_escape "${prl:-N/D}")" "$(json_escape "${mat:-N/D}")"

    printf '"sudo_log":['
    first=1
    local line
    while IFS= read -r line; do
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '"%s"' "$(json_escape "$line")"
    done < <(tail -n 15 /var/log/sudo.log 2>/dev/null || true)
    printf ']}\n'
}

api_samba() {
    validate_root
    local config_valid="false" first=1 s
    if testparm -s >/dev/null 2>&1; then
        config_valid="true"
    fi
    printf '{"config_valid":%s,"shares":[' "$config_valid"
    while IFS= read -r s; do
        [ -z "$s" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '"%s"' "$(json_escape "$s")"
    done < <(testparm -s 2>/dev/null | sed -n 's/^\[\(.*\)\].*/\1/p' | grep -v '^global$' || true)
    printf '],"sessions":['
    first=1
    local line pid user machine proto
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        pid="$(printf '%s' "$line" | awk '{print $1}')"
        user="$(printf '%s' "$line" | awk '{print $2}')"
        machine="$(printf '%s' "$line" | awk '{print $4}')"
        proto="$(printf '%s' "$line" | awk '{print $5}')"
        [ -z "$user" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '{"pid":"%s","user":"%s","machine":"%s","protocol":"%s"}' \
            "$(json_escape "$pid")" "$(json_escape "$user")" "$(json_escape "$machine")" "$(json_escape "$proto")"
    done < <(smbstatus -b 2>/dev/null | awk 'NF>=5 && $1 ~ /^[0-9]+$/' || true)
    printf ']}\n'
}

api_database() {
    validate_root
    local first=1 name size tables is_sys
    printf '{"databases":['
    while IFS=$'\t' read -r name size tables; do
        [ -z "$name" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        case "$name" in
            information_schema|performance_schema|mysql|sys) is_sys="true" ;;
            *) is_sys="false" ;;
        esac
        printf '{"name":"%s","size_mb":%s,"tables_count":%s,"is_system":%s}' \
            "$(json_escape "$name")" "${size:-0}" "${tables:-0}" "$is_sys"
    done < <(mariadb -N -e "SELECT s.SCHEMA_NAME, ROUND(COALESCE(SUM(t.data_length + t.index_length), 0) / 1024 / 1024, 2), COUNT(t.table_name) FROM information_schema.SCHEMATA s LEFT JOIN information_schema.TABLES t ON t.table_schema = s.SCHEMA_NAME GROUP BY s.SCHEMA_NAME ORDER BY s.SCHEMA_NAME;" 2>/dev/null || true)
    printf '],"users":['
    first=1
    local user host
    while IFS=$'\t' read -r user host; do
        [ -z "$user" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '{"user":"%s","host":"%s"}' "$(json_escape "$user")" "$(json_escape "$host")"
    done < <(mariadb -N -e "SELECT User, Host FROM mysql.user WHERE User NOT IN ('', 'root', 'pma') ORDER BY User, Host;" 2>/dev/null || true)
    printf ']'
    local q_threads="" q_running="" q_queries="" q_uptime="" qps="0"
    IFS=$'\t' read -r q_threads q_running q_queries q_uptime < <(mariadb -N -e "SELECT (SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME='Threads_connected'), (SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME='Threads_running'), (SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME='Queries'), (SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME='Uptime');" 2>/dev/null || true)
    if [ -n "${q_queries:-}" ] && [ -n "${q_uptime:-}" ]; then
        qps="$(awk -v q="$q_queries" -v u="$q_uptime" 'BEGIN { if (u < 1) u = 1; printf "%.1f", q / u }')"
    fi
    printf ',"status":{"threads":%s,"running":%s,"qps":%s}}\n' "${q_threads:-0}" "${q_running:-0}" "${qps:-0}"
}

cmd_service_restart() {
    validate_root
    load_config
    local unit="$1"
    [ -n "$unit" ] || die "Debes especificar el servicio a reiniciar. Ej: srvctl service restart apache2"

    local allowed="^(apache2|php[0-9.]*-fpm|mariadb|redis-server|smbd|ufw|fail2ban)$"
    if [[ ! "$unit" =~ $allowed ]]; then
        die "Servicio '${unit}' no permitido para reinicio. Permitidos: apache2, php8.4-fpm, mariadb, redis-server, smbd, ufw, fail2ban."
    fi

    log "[Servicio] Reiniciando ${unit}..."
    systemctl restart "$unit"
    log "[Servicio] Servicio ${unit} reiniciado correctamente."
}

cmd_service_reload() {
    validate_root
    load_config
    local unit="$1"
    [ -n "$unit" ] || die "Debes especificar el servicio a recargar. Ej: srvctl service reload apache2"

    local allowed="^(apache2|php[0-9.]*-fpm)$"
    if [[ ! "$unit" =~ $allowed ]]; then
        die "Servicio '${unit}' no permitido para recarga. Permitidos: apache2, php8.4-fpm."
    fi

    log "[Servicio] Recargando configuracion de ${unit}..."
    systemctl reload "$unit"
    log "[Servicio] Servicio ${unit} recargado correctamente."
}

cmd_security_scan() {
    validate_root
    load_config
    echo "=============================================================================="
    echo "           AUDITORIA DE SEGURIDAD Y HARDENING - $(date '+%Y-%m-%d %H:%M:%S')"
    echo "=============================================================================="

    local ISSUES=0
    local WARNS=0

    # 1. Cortafuegos UFW
    echo "--- 1. Estado del Cortafuegos (UFW) ---"
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        echo " [ OK ]   Cortafuegos UFW: Activo"
        local rule_count
        rule_count="$(ufw status 2>/dev/null | grep -cE 'ALLOW|DENY|REJECT|LIMIT' || echo 0)"
        echo " [ INFO ] Reglas UFW registradas: ${rule_count}"
    else
        echo " [FALLO]  Cortafuegos UFW: Inactivo o no configurado"
        ISSUES=$((ISSUES + 1))
    fi

    # 2. Prevencion de Intrusiones (Fail2ban)
    echo ""
    echo "--- 2. Prevencion de Intrusiones (Fail2ban) ---"
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
        echo " [ OK ]   Servicio fail2ban: Activo"
        local jail_status
        jail_status="$(fail2ban-client status sshd 2>/dev/null || true)"
        if [ -n "$jail_status" ]; then
            local banned_cnt
            banned_cnt="$(echo "$jail_status" | sed -n 's/.*Currently banned:[[:space:]]*//p' || echo 0)"
            echo " [ INFO ] Jaula sshd: Operativa (${banned_cnt:-0} IPs actualmente baneadas)"
        else
            echo " [AVISO]  Jaula sshd en fail2ban no detectada o inactiva"
            WARNS=$((WARNS + 1))
        fi
    else
        echo " [FALLO]  Servicio fail2ban: Inactivo"
        ISSUES=$((ISSUES + 1))
    fi

    # 3. Bastionado OpenSSH
    echo ""
    echo "--- 3. Bastionado OpenSSH ---"
    local ssh_root ssh_tries
    ssh_root="$(grep -rhiE '^[[:space:]]*PermitRootLogin' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | tail -1 | awk '{print $2}' || true)"
    ssh_tries="$(grep -rhiE '^[[:space:]]*MaxAuthTries' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | tail -1 | awk '{print $2}' || true)"

    if [ "$ssh_root" = "no" ] || [ "$ssh_root" = "prohibit-password" ]; then
        echo " [ OK ]   SSH PermitRootLogin: ${ssh_root:-no}"
    else
        echo " [AVISO]  SSH PermitRootLogin permisivo: ${ssh_root:-yes}"
        WARNS=$((WARNS + 1))
    fi

    if [ -n "$ssh_tries" ] && [ "$ssh_tries" -le 5 ]; then
        echo " [ OK ]   SSH MaxAuthTries restringido: ${ssh_tries}"
    else
        echo " [AVISO]  SSH MaxAuthTries alto o no definido: ${ssh_tries:-default (6)}"
        WARNS=$((WARNS + 1))
    fi

    # 4. Puertos a la escucha
    echo ""
    echo "--- 4. Puertos y Servicios en Escucha ---"
    local listening_ports
    if command -v ss >/dev/null 2>&1; then
        listening_ports="$(ss -tulpn 2>/dev/null | awk 'NR>1 {printf "  %-7s %-22s %s\n", $1, $5, $7}' | head -n 20 || true)"
    else
        listening_ports="$(netstat -tulpn 2>/dev/null | awk 'NR>2 {printf "  %-7s %-22s %s\n", $1, $4, $7}' | head -n 20 || true)"
    fi
    echo "${listening_ports:-  Ningun socket detectado}"

    # 5. Permisos de Archivos Criticos
    echo ""
    echo "--- 5. Permisos de Archivos y Credenciales ---"
    if [ -f /etc/srvctl.conf ]; then
        local perm_conf
        perm_conf="$(stat -c %a /etc/srvctl.conf 2>/dev/null || echo '000')"
        if [ "$perm_conf" = "600" ]; then
            echo " [ OK ]   /etc/srvctl.conf permisos: ${perm_conf} (modo protegido root:root)"
        else
            echo " [AVISO]  /etc/srvctl.conf permisos inseguros: ${perm_conf} (debe ser 600)"
            WARNS=$((WARNS + 1))
        fi
    fi

    if [ -d /etc/ssl/localcerts ]; then
        local open_keys
        open_keys="$(find /etc/ssl/localcerts -type f -name '*.key' ! -perm 400 2>/dev/null | wc -l)"
        if [ "$open_keys" -eq 0 ]; then
            echo " [ OK ]   Claves privadas SSL (/etc/ssl/localcerts/*.key) protegidas (0400)"
        else
            echo " [AVISO]  Existen ${open_keys} clave(s) privada(s) SSL sin permisos 0400"
            WARNS=$((WARNS + 1))
        fi
    fi

    # 6. Auditoria de Comandos Sudo
    echo ""
    echo "--- 6. Registro de Auditoria Sudo (/var/log/sudo.log) ---"
    if [ -f /var/log/sudo.log ]; then
        local sudo_entries
        sudo_entries="$(wc -l < /var/log/sudo.log 2>/dev/null || echo 0)"
        echo " [ OK ]   Archivo /var/log/sudo.log activo (${sudo_entries} eventos registrados)"
        echo " [ INFO ] Ultimos 5 eventos administrativos:"
        tail -n 5 /var/log/sudo.log 2>/dev/null | sed 's/^/         /' || true
    else
        echo " [AVISO]  /var/log/sudo.log no encontrado"
        WARNS=$((WARNS + 1))
    fi

    echo ""
    echo "=============================================================================="
    echo "Resumen de auditoria: ${ISSUES} fallos criticos, ${WARNS} advertencias."
    echo "=============================================================================="

    [ "$ISSUES" -eq 0 ]
}

cmd_system_check_updates() {
    validate_root
    log "[Sistema] Consultando repositorios Debian 13 para actualizaciones..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null

    echo "=============================================================================="
    echo "                 PAQUETES ACTUALIZABLES (DEBIAN 13)                           "
    echo "=============================================================================="
    local up_list
    up_list="$(apt list --upgradable 2>/dev/null | grep -v 'Listing...' || true)"
    if [ -n "$up_list" ]; then
        echo "$up_list"
        local up_count
        up_count="$(echo "$up_list" | wc -l)"
        echo "=============================================================================="
        echo "Total de paquetes actualizables: ${up_count}"
    else
        echo "El sistema esta completamente actualizado. No hay paquetes pendientes."
        echo "=============================================================================="
    fi
}

cmd_system_upgrade() {
    validate_root
    load_config
    local pkg="${1:-}"
    export DEBIAN_FRONTEND=noninteractive

    if [ -n "$pkg" ]; then
        if [[ ! "$pkg" =~ ^[a-zA-Z0-9.+_-]+$ ]]; then
            die "Nombre de paquete invalido: ${pkg}"
        fi
        log "[Sistema] Actualizando paquete especifico: ${pkg}..."
        apt-get install -y --only-upgrade "$pkg"
        log "[Sistema] Paquete '${pkg}' actualizado correctamente."
    else
        log "[Sistema] Ejecutando actualizacion completa del sistema..."
        apt-get update -y >/dev/null
        apt-get dist-upgrade -y
        log "[Sistema] Actualizacion del sistema completada exitosamente."
    fi
}

cmd_system_change_password() {
    validate_root
    load_config
    local new_pass="$1"
    [ -n "$new_pass" ] || die "Debes especificar la nueva contrasena. Ej: srvctl system change-password MiClaveSegura123"

    if [ "${#new_pass}" -lt 6 ]; then
        die "La contrasena debe tener al menos 6 caracteres."
    fi

    log "[Sistema] Actualizando contrasena administrativa..."

    # 1. Actualizar usuario del sistema operativo
    if id "${ADMIN_USER}" >/dev/null 2>&1; then
        echo "${ADMIN_USER}:${new_pass}" | chpasswd
        log "         Contrasena de sistema actualizada para '${ADMIN_USER}'."
    fi

    # 2. Actualizar MariaDB
    mariadb -e "ALTER USER IF EXISTS '${ADMIN_USER}'@'localhost' IDENTIFIED BY '${new_pass}'; ALTER USER IF EXISTS '${ADMIN_USER}'@'127.0.0.1' IDENTIFIED BY '${new_pass}'; FLUSH PRIVILEGES;" 2>/dev/null || true
    log "         Contrasena de MariaDB actualizada para '${ADMIN_USER}'."

    # 3. Actualizar Samba
    if command -v smbpasswd >/dev/null 2>&1; then
        (echo "${new_pass}"; echo "${new_pass}") | smbpasswd -s "${ADMIN_USER}" 2>/dev/null || true
        log "         Contrasena de Samba SMB actualizada para '${ADMIN_USER}'."
    fi

    # 4. Actualizar /etc/srvctl.conf
    ADMIN_PASS="${new_pass}"
    save_config
    log "         /etc/srvctl.conf actualizado con nueva contrasena maestra."

    # 5. Actualizar hash en /etc/srvctl-panel.conf
    local panel_conf="/etc/srvctl-panel.conf"
    if [ -f "$panel_conf" ]; then
        local new_hash
        new_hash="$(SRVCTL_PANEL_PW="${new_pass}" php -r 'echo password_hash((string)getenv("SRVCTL_PANEL_PW"), PASSWORD_DEFAULT);' 2>/dev/null || true)"
        if [ -n "$new_hash" ]; then
            if grep -q '^PANEL_PASS_HASH=' "$panel_conf"; then
                sed -i "s|^PANEL_PASS_HASH=.*|PANEL_PASS_HASH='${new_hash}'|" "$panel_conf"
            else
                echo "PANEL_PASS_HASH='${new_hash}'" >> "$panel_conf"
            fi
            chmod 640 "$panel_conf" 2>/dev/null || true
            chown root:www-data "$panel_conf" 2>/dev/null || true
            log "         /etc/srvctl-panel.conf actualizado con nuevo hash de sesion."
        fi
    fi

    log "[Sistema] Contrasena administrativa actualizada en todos los servicios."
}

cmd_api() {
    case "${1:-}" in
        security) api_security ;;
        samba)    api_samba ;;
        database) api_database ;;
        *)        die "Uso: srvctl api [security|samba|database]" ;;
    esac
}

show_tui() {
    if ! command -v whiptail >/dev/null 2>&1; then
        echo "Uso: srvctl [deploy|status|verify|service|firewall|security|ssl|backup|db|cache|system|project|reset]"
        exit 1
    fi

    local choice
    choice=$(whiptail --title "Gestor de Servidor Web Debian 13 (srvctl)" \
        --menu "Selecciona una accion para continuar:" 20 72 10 \
        "1" "Desplegar Servidor (Instalacion Guiada)" \
        "2" "Estado de Salud y Monitoreo Basico" \
        "3" "Diagnostico y Auto-verificacion (Suite 40 Puntos)" \
        "4" "Crear Nuevo Proyecto Web (Carpeta + Git)" \
        "5" "Crear Base de Datos para Proyecto (MariaDB + .env)" \
        "6" "Listar Proyectos Web Activos" \
        "7" "Ejecutar Respaldo Inmediato" \
        "8" "Listar Respaldos y Snapshots" \
        "9" "Resetear / Limpiar Servidor" \
        "10" "Salir" 3>&1 1>&2 2>&3)

    case "$choice" in
        1) cmd_deploy ;;
        2) cmd_status; read -rp "Presiona Enter para continuar..." ;;
        3) cmd_verify; read -rp "Presiona Enter para continuar..." ;;
        4)
            local p_name
            p_name=$(whiptail --inputbox "Ingresa el nombre del nuevo proyecto (ej. tienda):" 10 50 3>&1 1>&2 2>&3)
            if [ -n "$p_name" ]; then
                cmd_project_create "$p_name"
                read -rp "Presiona Enter para continuar..."
            fi
            ;;
        5)
            local db_pname
            db_pname=$(whiptail --inputbox "Ingresa el nombre del proyecto para su Base de Datos (ej. tienda):" 10 50 3>&1 1>&2 2>&3)
            if [ -n "$db_pname" ]; then
                cmd_project_db "$db_pname"
                read -rp "Presiona Enter para continuar..."
            fi
            ;;
        6) cmd_project_list; read -rp "Presiona Enter para continuar..." ;;
        7) bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" setup; read -rp "Presiona Enter..." ;;
        8) bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" list; read -rp "Presiona Enter..." ;;
        9)
            if (whiptail --title "Confirmar Reset" --yesno "¿Estas seguro de purgar todos los paquetes y datos?" 10 60); then
                cmd_reset
                read -rp "Presiona Enter para continuar..."
            fi
            ;;
        *) exit 0 ;;
    esac
}

# Entrypoint CLI
subcmd="${1:-}"
case "$subcmd" in
    deploy)  cmd_deploy ;;
    status)  cmd_status ;;
    verify)  cmd_verify ;;
    service)
        case "${2:-}" in
            restart) cmd_service_restart "${3:-}" ;;
            reload)  cmd_service_reload "${3:-}" ;;
            *) die "Uso: srvctl service [restart <unit>|reload <unit>]" ;;
        esac
        ;;
    firewall)
        case "${2:-}" in
            toggle) bash "${SRVCTL_ROOT}/modules/security/firewall.sh" toggle "${3:-}" ;;
            allow)  bash "${SRVCTL_ROOT}/modules/security/firewall.sh" allow "${3:-}" "${4:-}" ;;
            delete) bash "${SRVCTL_ROOT}/modules/security/firewall.sh" delete "${3:-}" ;;
            *) die "Uso: srvctl firewall [toggle [on|off]|allow <puerto>[/<proto>] [<comentario>]|delete <num|puerto>]" ;;
        esac
        ;;
    security)
        case "${2:-}" in
            ban)   bash "${SRVCTL_ROOT}/modules/security/firewall.sh" ban "${3:-}" ;;
            unban) bash "${SRVCTL_ROOT}/modules/security/firewall.sh" unban "${3:-}" ;;
            scan)  cmd_security_scan ;;
            *) die "Uso: srvctl security [ban <ip>|unban <ip>|scan]" ;;
        esac
        ;;
    ssl)
        case "${2:-}" in
            renew) bash "${SRVCTL_ROOT}/modules/web/ssl.sh" renew ;;
            *) die "Uso: srvctl ssl [renew]" ;;
        esac
        ;;
    backup)
        case "${2:-}" in
            run)              bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" setup ;;
            list)             bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" list ;;
            rollback)         bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" rollback "${3:-daily.0}" ;;
            rollback-project) bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" rollback-project "${3:-}" "${4:-daily.0}" ;;
            restore-db)       bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" restore-db "${3:-}" ;;
            verify)           bash "${SRVCTL_ROOT}/modules/backup/snapshot.sh" verify ;;
            *) die "Uso: srvctl backup [run|list|rollback <snapshot>|rollback-project <proyecto> [snap]|restore-db <dump>|verify]" ;;
        esac
        ;;
    db)
        case "${2:-}" in
            create)   bash "${SRVCTL_ROOT}/modules/stack/mariadb.sh" create "${3:-}" "${4:-}" "${5:-}" ;;
            delete)   bash "${SRVCTL_ROOT}/modules/stack/mariadb.sh" delete "${3:-}" ;;
            optimize) bash "${SRVCTL_ROOT}/modules/stack/mariadb.sh" optimize ;;
            *) die "Uso: srvctl db [create <name> <user> [<pass>]|delete <name>|optimize]" ;;
        esac
        ;;
    cache)
        case "${2:-}" in
            flush-redis) bash "${SRVCTL_ROOT}/modules/stack/redis.sh" flush ;;
            *) die "Uso: srvctl cache [flush-redis]" ;;
        esac
        ;;
    system)
        case "${2:-}" in
            check-updates)   cmd_system_check_updates ;;
            upgrade)         cmd_system_upgrade "${3:-}" ;;
            change-password) cmd_system_change_password "${3:-}" ;;
            *) die "Uso: srvctl system [check-updates|upgrade [<paquete>]|change-password <clave>]" ;;
        esac
        ;;
    project)
        case "${2:-}" in
            create) cmd_project_create "${3:-}" ;;
            db)     cmd_project_db "${3:-}" "${4:-}" ;;
            delete) cmd_project_delete "${3:-}" "${4:-}" ;;
            list)   cmd_project_list ;;
            *) die "Uso: srvctl project [create <nombre>|db <nombre>|delete <nombre>|list]" ;;
        esac
        ;;
    api)     cmd_api "${2:-}" ;;
    reset)   cmd_reset ;;
    "")      show_tui ;;
    *)       die "Comando desconocido: $subcmd. Usa: srvctl [deploy|status|verify|service|firewall|security|ssl|backup|db|cache|system|project|reset]" ;;
esac
